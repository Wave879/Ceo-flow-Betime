rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collections used by the dashboard web app and Cloudflare backend.
    match /tasks/{docId} {
      allow read, write: if true;

      match /replies/{replyId} {
        allow read, write: if true;
      }
    }

    match /employees/{docId} {
      allow read, write: if true;
    }

    match /positions/{docId} {
      allow read, write: if true;
    }

    match /projects/{projectId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /members/{memberId} {
        allow read, write: if true;
      }
    }

    match /groupUsers/{userId} {
      allow read, write: if true;
    }

    match /lineUsers/{userId} {
      allow read, write: if true;
    }

    match /aliveModes/{scopeId} {
      allow read, write: if true;
    }

    // Deny unknown collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
