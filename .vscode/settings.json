{
  "files.exclude": {
    "**/node_modules": true,
    "**/.wrangler": true,
    "**/.pages-deploy": true,
    "**/dist": true,
    "**/.firebase": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.wrangler": true,
    "**/.pages-deploy": true,
    "**/dist": true,
    "**/.firebase": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.wrangler/**": true,
    "**/.pages-deploy/**": true,
    "**/dist/**": true,
    "**/.firebase/**": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python"
  },
  "python.analysis.extraPaths": [],
  "python.analysis.typeshedPath": "",
  "python.linting.enabled": false,
  "python.formatting.provider": "none",
  "extensions.recommendations": [],
  "extensions.ignoreRecommendations": true
}
